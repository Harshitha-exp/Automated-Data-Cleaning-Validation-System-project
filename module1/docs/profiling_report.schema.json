{
  "$defs": {
    "CardinalityInfo": {
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "n_unique": {
          "title": "N Unique",
          "type": "integer"
        },
        "unique_ratio": {
          "title": "Unique Ratio",
          "type": "number"
        },
        "is_constant": {
          "title": "Is Constant",
          "type": "boolean"
        },
        "is_high_cardinality": {
          "title": "Is High Cardinality",
          "type": "boolean"
        },
        "top_values": {
          "anyOf": [
            {
              "additionalProperties": {
                "type": "integer"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Top Values"
        }
      },
      "required": [
        "column",
        "n_unique",
        "unique_ratio",
        "is_constant",
        "is_high_cardinality"
      ],
      "title": "CardinalityInfo",
      "type": "object"
    },
    "ColumnMetadata": {
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "position": {
          "title": "Position",
          "type": "integer"
        },
        "pandas_dtype": {
          "title": "Pandas Dtype",
          "type": "string"
        },
        "inferred_type": {
          "enum": [
            "integer",
            "float",
            "boolean",
            "datetime",
            "categorical",
            "text",
            "empty",
            "unknown"
          ],
          "title": "Inferred Type",
          "type": "string"
        },
        "semantic_type": {
          "default": "none",
          "enum": [
            "name",
            "email",
            "phone",
            "date",
            "id",
            "url",
            "currency",
            "zipcode",
            "ip_address",
            "country",
            "gender",
            "age",
            "address",
            "none"
          ],
          "title": "Semantic Type",
          "type": "string"
        },
        "semantic_confidence": {
          "default": 0.0,
          "maximum": 1,
          "minimum": 0,
          "title": "Semantic Confidence",
          "type": "number"
        },
        "is_mixed_type": {
          "default": false,
          "title": "Is Mixed Type",
          "type": "boolean"
        },
        "type_distribution": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Type Distribution",
          "type": "object"
        }
      },
      "required": [
        "name",
        "position",
        "pandas_dtype",
        "inferred_type"
      ],
      "title": "ColumnMetadata",
      "type": "object"
    },
    "CorrelationMatrix": {
      "properties": {
        "method": {
          "title": "Method",
          "type": "string"
        },
        "columns": {
          "items": {
            "type": "string"
          },
          "title": "Columns",
          "type": "array"
        },
        "matrix": {
          "items": {
            "items": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "array"
          },
          "title": "Matrix",
          "type": "array"
        },
        "strong_pairs": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Strong Pairs",
          "type": "array"
        }
      },
      "required": [
        "method",
        "columns",
        "matrix"
      ],
      "title": "CorrelationMatrix",
      "type": "object"
    },
    "DatasetInfo": {
      "properties": {
        "source_name": {
          "title": "Source Name",
          "type": "string"
        },
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_cols": {
          "title": "N Cols",
          "type": "integer"
        },
        "sampled": {
          "default": false,
          "title": "Sampled",
          "type": "boolean"
        },
        "sample_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Size"
        }
      },
      "required": [
        "source_name",
        "n_rows",
        "n_cols"
      ],
      "title": "DatasetInfo",
      "type": "object"
    },
    "Flag": {
      "properties": {
        "column": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Column"
        },
        "rule_id": {
          "title": "Rule Id",
          "type": "string"
        },
        "category": {
          "enum": [
            "suspicious",
            "format_inconsistency",
            "pii"
          ],
          "title": "Category",
          "type": "string"
        },
        "severity": {
          "enum": [
            "info",
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "confidence": {
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "message": {
          "title": "Message",
          "type": "string"
        },
        "evidence": {
          "additionalProperties": true,
          "title": "Evidence",
          "type": "object"
        }
      },
      "required": [
        "rule_id",
        "category",
        "severity",
        "confidence",
        "message"
      ],
      "title": "Flag",
      "type": "object"
    },
    "Metadata": {
      "properties": {
        "n_rows": {
          "title": "N Rows",
          "type": "integer"
        },
        "n_cols": {
          "title": "N Cols",
          "type": "integer"
        },
        "memory_bytes": {
          "title": "Memory Bytes",
          "type": "integer"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/ColumnMetadata"
          },
          "title": "Columns",
          "type": "array"
        }
      },
      "required": [
        "n_rows",
        "n_cols",
        "memory_bytes",
        "columns"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "MissingColumn": {
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "missing_count": {
          "title": "Missing Count",
          "type": "integer"
        },
        "missing_pct": {
          "title": "Missing Pct",
          "type": "number"
        }
      },
      "required": [
        "column",
        "missing_count",
        "missing_pct"
      ],
      "title": "MissingColumn",
      "type": "object"
    },
    "MissingSummary": {
      "properties": {
        "total_missing_cells": {
          "title": "Total Missing Cells",
          "type": "integer"
        },
        "total_missing_pct": {
          "title": "Total Missing Pct",
          "type": "number"
        },
        "columns": {
          "items": {
            "$ref": "#/$defs/MissingColumn"
          },
          "title": "Columns",
          "type": "array"
        },
        "top_patterns": {
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Top Patterns",
          "type": "array"
        }
      },
      "required": [
        "total_missing_cells",
        "total_missing_pct",
        "columns"
      ],
      "title": "MissingSummary",
      "type": "object"
    },
    "NumericDistribution": {
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "mean": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mean"
        },
        "std": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Std"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "q1": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q1"
        },
        "median": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Median"
        },
        "q3": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Q3"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "skew": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skew"
        },
        "kurtosis": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Kurtosis"
        },
        "outliers_iqr": {
          "default": 0,
          "title": "Outliers Iqr",
          "type": "integer"
        },
        "outliers_zscore": {
          "default": 0,
          "title": "Outliers Zscore",
          "type": "integer"
        },
        "histogram": {
          "anyOf": [
            {
              "additionalProperties": {
                "items": {
                  "type": "number"
                },
                "type": "array"
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Histogram"
        }
      },
      "required": [
        "column"
      ],
      "title": "NumericDistribution",
      "type": "object"
    },
    "Statistics": {
      "properties": {
        "missing": {
          "$ref": "#/$defs/MissingSummary"
        },
        "cardinality": {
          "items": {
            "$ref": "#/$defs/CardinalityInfo"
          },
          "title": "Cardinality",
          "type": "array"
        },
        "type_consistency": {
          "items": {
            "$ref": "#/$defs/TypeConsistency"
          },
          "title": "Type Consistency",
          "type": "array"
        },
        "distributions": {
          "items": {
            "$ref": "#/$defs/NumericDistribution"
          },
          "title": "Distributions",
          "type": "array"
        },
        "correlations": {
          "items": {
            "$ref": "#/$defs/CorrelationMatrix"
          },
          "title": "Correlations",
          "type": "array"
        }
      },
      "required": [
        "missing",
        "cardinality",
        "type_consistency",
        "distributions",
        "correlations"
      ],
      "title": "Statistics",
      "type": "object"
    },
    "TypeConsistency": {
      "properties": {
        "column": {
          "title": "Column",
          "type": "string"
        },
        "expected_type": {
          "title": "Expected Type",
          "type": "string"
        },
        "consistent_pct": {
          "title": "Consistent Pct",
          "type": "number"
        },
        "inconsistent_examples": {
          "items": {
            "type": "string"
          },
          "title": "Inconsistent Examples",
          "type": "array"
        }
      },
      "required": [
        "column",
        "expected_type",
        "consistent_pct"
      ],
      "title": "TypeConsistency",
      "type": "object"
    },
    "VisualisationRef": {
      "properties": {
        "name": {
          "enum": [
            "missing_heatmap",
            "outlier_distribution",
            "correlation_heatmap"
          ],
          "title": "Name",
          "type": "string"
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Path"
        },
        "base64_png": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base64 Png"
        }
      },
      "required": [
        "name"
      ],
      "title": "VisualisationRef",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "generated_at": {
      "title": "Generated At",
      "type": "string"
    },
    "dataset": {
      "$ref": "#/$defs/DatasetInfo"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "statistics": {
      "$ref": "#/$defs/Statistics"
    },
    "visualisations": {
      "items": {
        "$ref": "#/$defs/VisualisationRef"
      },
      "title": "Visualisations",
      "type": "array"
    },
    "flags": {
      "items": {
        "$ref": "#/$defs/Flag"
      },
      "title": "Flags",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "dataset",
    "metadata",
    "statistics",
    "visualisations",
    "flags"
  ],
  "title": "ProfilingReport",
  "type": "object"
}
